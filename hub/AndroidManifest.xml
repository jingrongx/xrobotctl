<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.visbot.robotctl"
    android:versionCode="10001"
    android:versionName="1.0.1">

    <uses-permission android:name="com.ubtrobot.permission.ROBOT" />
    <uses-permission android:name="com.ubtrobot.master.permission.MASTER" />
    <uses-permission android:name="com.ubtrobot.master.permission.MASTER_SYSTEM_SERVICE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="26" />

    <application
        android:name="com.xrobot.hub.HubApp"
        android:label="XRobot 中枢"
        android:debuggable="true">

        <provider
            android:name="com.xrobot.hub.HubProvider"
            android:authorities="com.xrobot.hub.api;com.visbot.robotctl.api"
            android:exported="true" />

        <service
            android:name="com.xrobot.hub.HubService"
            android:exported="false" />

        <activity
            android:name="com.xrobot.hub.MainActivity"
            android:label="XRobot 中枢"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.xrobot.hub.DebugActivity"
            android:label="XRobot 调试"
            android:exported="false" />
    </application>
</manifest>
